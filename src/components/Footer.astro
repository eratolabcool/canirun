---
import { siteConfig } from "@/config/site";

interface Props {
  class?: string;
}

const { class: className = "mt-16" } = Astro.props;
const hasSlot = Astro.slots.has("default");
const year = new Date().getFullYear();
---

<footer class:list={["border-t border-edge/70 bg-surface-raised/45", className]}>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-[1.3fr_0.7fr_0.7fr]">
    <div>
      <a href="/" class="text-lg font-semibold tracking-tight text-primary">{siteConfig.shortName}</a>
      <p class="mt-3 max-w-md text-sm leading-6 text-secondary">
        A practical hardware decision tool for local language, image, video, audio, and ComfyUI workloads.
      </p>
      {hasSlot && <div class="mt-4 text-sm text-secondary"><slot /></div>}
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Tools</p>
      <div class="mt-4 grid gap-3 text-sm text-secondary">
        <a href="/" class="hover:text-accent">Detect my PC</a>
        <a href="/ai-video" class="hover:text-accent">Can I Run AI Video</a>
        <a href="/advisor" class="hover:text-accent">Model hardware advisor</a>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Resources</p>
      <div class="mt-4 grid gap-3 text-sm text-secondary">
        <a href="/compare" class="hover:text-accent">Compare hardware</a>
        <a href="/docs" class="hover:text-accent">Guides</a>
        <a href={siteConfig.repositoryUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub ↗</a>
      </div>
    </div>
  </div>

  <div class="border-t border-edge/70 px-4 py-5">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 text-xs leading-5 text-muted sm:flex-row sm:items-center sm:justify-between sm:px-2">
      <p>© {year} {siteConfig.shortName}. Independent hardware planning estimates.</p>
      <p class="max-w-3xl">Compatibility, memory, and speed figures are estimates, not performance guarantees. Product names and trademarks belong to their respective owners.</p>
    </div>
  </div>
</footer>
