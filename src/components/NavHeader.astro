---
import Logo from "@/icons/logo.svg";
import { siteConfig } from "@/config/site";

const currentPath = Astro.url.pathname;
const links = [
  { href: "/ai-video", label: "Can I Run AI Video?" },
  { href: "/advisor", label: "Can I Run This Model?" },
  { href: "/compare", label: "Can My GPU Run AI?" },
  { href: "/docs", label: "Can I Run AI? Guides" },
];

function isActive(href: string) {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-edge/70 bg-surface/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6" aria-label="Primary navigation">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${siteConfig.shortName} home — Can I Run AI locally?`}>
      <span class="flex size-9 items-center justify-center rounded-xl border border-edge bg-surface-card text-accent shadow-sm transition-colors group-hover:border-accent/50">
        <Logo class="size-4" />
      </span>
      <span class="text-[15px] font-semibold tracking-[-0.02em] text-primary">{siteConfig.shortName}</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "rounded-lg px-3 py-2 text-xs font-medium transition-colors lg:text-sm",
            isActive(href) ? "bg-surface-card text-primary" : "text-secondary hover:bg-surface-card/70 hover:text-primary",
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        class="flex size-9 cursor-pointer items-center justify-center rounded-lg border border-transparent text-secondary transition-colors hover:border-edge hover:bg-surface-card hover:text-primary"
        aria-label="Toggle theme"
      >
        <svg class="theme-icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
        <svg class="theme-icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <a href="/#hw-panel" class="hidden rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white shadow-[0_8px_26px_rgba(101,85,220,0.24)] transition-all hover:-translate-y-0.5 hover:bg-accent-strong sm:inline-flex">
        Can I Run AI?
      </a>

      <button
        id="menu-toggle"
        class="flex size-9 items-center justify-center rounded-lg text-secondary transition-colors hover:bg-surface-card hover:text-primary md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="3" y1="5" x2="17" y2="5"/><line x1="3" y1="10" x2="17" y2="10"/><line x1="3" y1="15" x2="17" y2="15"/></svg>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] flex flex-col bg-surface transition-all duration-300 ease-out md:hidden"
  style="opacity:0;visibility:hidden;transform:translateY(-8px)"
  aria-hidden="true"
>
  <div class="flex h-16 items-center justify-between border-b border-edge/70 px-4">
    <a href="/" class="flex items-center gap-2.5">
      <span class="flex size-9 items-center justify-center rounded-xl border border-edge bg-surface-card text-accent"><Logo class="size-4" /></span>
      <span class="font-semibold text-primary">{siteConfig.shortName}</span>
    </a>
    <button id="menu-close" class="flex size-10 items-center justify-center rounded-xl text-secondary hover:bg-surface-card hover:text-primary" aria-label="Close menu">
      <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="4" x2="16" y2="16"/><line x1="16" y1="4" x2="4" y2="16"/></svg>
    </button>
  </div>

  <div class="flex flex-1 flex-col px-5 py-8">
    <p class="eyebrow">Can I Run AI?</p>
    <div class="mt-6 grid gap-2">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "mobile-menu-link rounded-2xl px-4 py-4 text-xl font-semibold transition-colors",
            isActive(href) ? "bg-surface-card text-accent" : "text-primary hover:bg-surface-card",
          ]}
        >
          {label}
        </a>
      ))}
    </div>
    <a href="/#hw-panel" class="mobile-menu-link primary-button mt-auto">Can I Run AI on My PC?</a>
  </div>
</div>

<script>
  function initNavHeader() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const close = document.getElementById("menu-close");
    if (!toggle || !menu || !close || toggle.dataset.ready === "true") return;
    toggle.dataset.ready = "true";

    function open() {
      menu!.style.visibility = "visible";
      requestAnimationFrame(() => {
        menu!.style.opacity = "1";
        menu!.style.transform = "translateY(0)";
      });
      toggle!.setAttribute("aria-expanded", "true");
      menu!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function shut() {
      menu!.style.opacity = "0";
      menu!.style.transform = "translateY(-8px)";
      toggle!.setAttribute("aria-expanded", "false");
      menu!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => { menu!.style.visibility = "hidden"; }, 300);
    }

    toggle.addEventListener("click", open);
    close.addEventListener("click", shut);
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", shut));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.getAttribute("aria-hidden") === "false") shut();
    });
  }

  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.ready === "true") return;
    btn.dataset.ready = "true";
    btn.addEventListener("click", () => {
      const isLight = document.documentElement.classList.toggle("light");
      localStorage.setItem("theme", isLight ? "light" : "dark");
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isLight ? "#f6f7fc" : "#080b17");
    });
  }

  document.addEventListener("astro:page-load", () => {
    initNavHeader();
    initThemeToggle();
  });
</script>

<style>
  .theme-icon-moon { display: none; }
  :global(html.light) .theme-icon-sun { display: none; }
  :global(html.light) .theme-icon-moon { display: block; }
</style>
