---
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import "@/styles/legacy-components.css";
import { siteConfig } from "@/config/site";
import { CANONICAL_ORIGIN, resolveSeo } from "@/config/seo";
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string[];
}

const {
  title: rawTitle = `Can I Run AI Locally? Check Your PC, GPU and Mac — ${siteConfig.shortName}`,
  description: rawDescription = siteConfig.description,
  image = "/og/home.jpg",
  type = "website",
  keywords: extraKeywords = [],
} = Astro.props;

const seo = resolveSeo(Astro.url.pathname, rawTitle, rawDescription, extraKeywords);
const { title, description, canonical: canonicalURL, keywords } = seo;
const ogImageURL = new URL(image, CANONICAL_ORIGIN);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.href} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="theme-color" content="#080b17" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function(){
        function applyTheme(){
          var t=localStorage.getItem("theme");
          if(t==="light"||(!t&&matchMedia("(prefers-color-scheme: light)").matches)){
            document.documentElement.classList.add("light");
            document.querySelector('meta[name="theme-color"]').setAttribute("content","#f6f7fc");
          } else {
            document.documentElement.classList.remove("light");
            document.querySelector('meta[name="theme-color"]').setAttribute("content","#080b17");
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap",applyTheme);
      })();
    </script>

    <GoogleAnalytics />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteConfig.shortName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: title,
      url: canonicalURL.href,
      description,
      isPartOf: {
        "@type": "WebSite",
        name: siteConfig.shortName,
        url: siteConfig.url,
      },
    })}></script>

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface text-primary font-sans">
    <slot />
    <script>
      function initTooltips() {
        let popup: HTMLDivElement | null = null;
        let arrow: HTMLDivElement | null = null;
        let currentTrigger: HTMLElement | null = null;
        let hideTimeout: ReturnType<typeof setTimeout> | null = null;

        function show(trigger: HTMLElement) {
          const text = trigger.dataset.tooltip;
          if (!text) return;
          if (hideTimeout) { clearTimeout(hideTimeout); hideTimeout = null; }
          if (currentTrigger === trigger && popup) return;
          hide(true);
          currentTrigger = trigger;
          const pos = trigger.dataset.tooltipPos === "bottom" ? "bottom" : "top";
          popup = document.createElement("div");
          popup.className = `tooltip-popup${pos === "bottom" ? " tooltip-bottom" : ""}`;
          popup.setAttribute("role", "tooltip");
          popup.textContent = text;
          arrow = document.createElement("div");
          arrow.className = `tooltip-arrow tooltip-arrow-${pos === "bottom" ? "bottom" : "top"}`;
          popup.appendChild(arrow);
          document.body.appendChild(popup);
          const rect = trigger.getBoundingClientRect();
          const popRect = popup.getBoundingClientRect();
          let left = rect.left + rect.width / 2 - popRect.width / 2;
          left = Math.max(8, Math.min(left, window.innerWidth - popRect.width - 8));
          let top: number;
          if (pos === "bottom") {
            top = rect.bottom + 8;
          } else {
            top = rect.top - popRect.height - 8;
            if (top < 8) {
              top = rect.bottom + 8;
              popup.classList.add("tooltip-bottom");
              arrow.className = "tooltip-arrow tooltip-arrow-bottom";
            }
          }
          popup.style.left = `${left}px`;
          popup.style.top = `${top}px`;
          const arrowLeft = rect.left + rect.width / 2 - left;
          arrow.style.left = `${arrowLeft}px`;
          arrow.style.transform = "translateX(-50%)";
          requestAnimationFrame(() => popup?.classList.add("visible"));
        }

        function hide(immediate = false) {
          if (!popup) return;
          const el = popup;
          currentTrigger = null;
          if (immediate) {
            el.remove(); popup = null; arrow = null; return;
          }
          el.classList.remove("visible");
          const cleanup = () => { el.remove(); if (popup === el) { popup = null; arrow = null; } };
          el.addEventListener("transitionend", cleanup, { once: true });
          setTimeout(cleanup, 250);
        }

        document.addEventListener("mouseover", (event) => {
          const trigger = (event.target as Element).closest<HTMLElement>("[data-tooltip]");
          if (trigger) show(trigger);
        });
        document.addEventListener("mouseout", (event) => {
          const trigger = (event.target as Element).closest<HTMLElement>("[data-tooltip]");
          if (!trigger) return;
          const related = event.relatedTarget as Element | null;
          if (!trigger.contains(related)) hideTimeout = setTimeout(() => hide(), 80);
        });
        document.addEventListener("focusin", (event) => {
          const trigger = (event.target as Element).closest<HTMLElement>("[data-tooltip]");
          if (trigger) show(trigger);
        });
        document.addEventListener("focusout", (event) => {
          const trigger = (event.target as Element).closest<HTMLElement>("[data-tooltip]");
          if (trigger) hide();
        });
        document.addEventListener("keydown", (event) => { if (event.key === "Escape") hide(); });
      }

      initTooltips();
      document.addEventListener("astro:after-swap", initTooltips);
    </script>
  </body>
</html>
