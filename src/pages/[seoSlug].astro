---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import Footer from "@/components/Footer.astro";
import {
  seoPages,
  getAdvisorModel,
  getHardwareProfile,
  hardwareForModel,
  modelsForHardware,
  fitLevel,
  fitLabel,
  categoryLabels,
  advisorDisclaimer,
  type SeoPage,
} from "@/data/advisor";
import { siteConfig } from "@/config/site";

export function getStaticPaths() {
  return seoPages.map((page) => ({ params: { seoSlug: page.slug }, props: { page } }));
}

interface Props { page: SeoPage }
const { page } = Astro.props;
const model = page.modelSlug ? getAdvisorModel(page.modelSlug) : undefined;
const hardware = page.hardwareSlug ? getHardwareProfile(page.hardwareSlug) : undefined;
const verdict = model && hardware ? fitLevel(model, hardware) : undefined;
const modelHardware = model ? hardwareForModel(model) : [];
const hardwareModels = hardware ? modelsForHardware(hardware) : [];
const memoryModels = page.ramGb
  ? (await import("@/data/advisor")).advisorModels.filter((item) => item.minRamGb <= page.ramGb!)
  : [];

const faq = [
  {
    question: `Are these ${model?.name ?? hardware?.name ?? "local AI"} requirements exact?`,
    answer: advisorDisclaimer,
  },
  {
    question: "Does quantization reduce memory use?",
    answer: "Yes. Lower-bit quantization can reduce model memory substantially, but quality, runtime support, context size, and speed still vary by model and backend.",
  },
  {
    question: "Is system RAM the same as GPU VRAM?",
    answer: "No. Dedicated GPU VRAM is normally much faster for inference. System RAM can support CPU execution or offload, while Apple Silicon shares one unified memory pool between CPU and GPU.",
  },
];
---

<Layout title={`${page.title} — ${siteConfig.shortName}`} description={page.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    })}></script>
  </Fragment>

  <NavHeader />
  <main class="mx-auto max-w-5xl px-4 pb-20 pt-10 sm:px-6">
    <nav class="font-mono text-xs text-muted" aria-label="Breadcrumb">
      <a href="/advisor" class="hover:text-accent">Hardware advisor</a>
      <span class="mx-2">/</span>
      <span>{page.h1}</span>
    </nav>

    <header class="mt-8 max-w-4xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
        {page.kind === "compatibility" ? "Compatibility answer" : page.kind === "requirements" ? "System requirements" : page.kind === "hardware" ? "Hardware model list" : page.kind === "memory" ? "Memory guide" : "Buying guide"}
      </p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">{page.h1}</h1>
      <div class="mt-7 rounded-lg border border-accent/60 bg-surface-raised p-6 sm:p-8">
        <p class="font-mono text-xs uppercase tracking-wider text-accent">Direct answer</p>
        <p class="mt-3 text-xl leading-8 text-primary">{page.answer}</p>
        {verdict && <p class="mt-4 font-mono text-sm text-secondary">Calculated verdict: <strong class="text-primary">{fitLabel(verdict)}</strong></p>}
      </div>
    </header>

    {model && (
      <section class="mt-12">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-lg border border-edge bg-surface-raised p-5">
            <p class="font-mono text-xs uppercase text-muted">Minimum VRAM</p>
            <p class="mt-2 text-3xl font-semibold">{model.minVramGb} GB</p>
          </article>
          <article class="rounded-lg border border-accent/60 bg-surface-raised p-5">
            <p class="font-mono text-xs uppercase text-accent">Recommended VRAM</p>
            <p class="mt-2 text-3xl font-semibold">{model.recommendedVramGb} GB</p>
          </article>
          <article class="rounded-lg border border-edge bg-surface-raised p-5">
            <p class="font-mono text-xs uppercase text-muted">Recommended RAM</p>
            <p class="mt-2 text-3xl font-semibold">{model.recommendedRamGb} GB</p>
          </article>
          <article class="rounded-lg border border-edge bg-surface-raised p-5">
            <p class="font-mono text-xs uppercase text-muted">Storage</p>
            <p class="mt-2 text-3xl font-semibold">{model.storageGb} GB</p>
          </article>
        </div>
        <p class="mt-4 font-mono text-xs text-muted">Assumed preset: {model.testedPreset}</p>
      </section>
    )}

    {hardware && (
      <section class="mt-12 rounded-lg border border-edge bg-surface-raised p-6 sm:p-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-accent">Hardware profile</p>
            <h2 class="mt-3 text-3xl font-semibold">{hardware.name}</h2>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-secondary">{hardware.summary}</p>
          </div>
          <div class="shrink-0 rounded-md border border-edge bg-surface px-4 py-3 font-mono text-sm text-secondary">
            {hardware.unifiedMemory ? `${hardware.ramGb} GB unified memory` : `${hardware.vramGb} GB VRAM · ${hardware.ramGb} GB RAM`}
          </div>
        </div>
      </section>
    )}

    {(page.kind === "requirements" || page.kind === "recommendation") && model && (
      <section class="mt-14">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Hardware choices</p>
        <h2 class="mt-2 text-3xl font-semibold">Configurations that can run {model.name}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {modelHardware.map(({ hardware: option, fit }) => (
            <a href={`/advisor/hardware/${option.slug}`} class="rounded-lg border border-edge bg-surface-raised p-5 transition-colors hover:border-accent">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-xs uppercase text-muted">{option.role}</p>
                  <h3 class="mt-2 text-xl font-semibold">{option.name}</h3>
                </div>
                <span class:list={["rounded-full px-2.5 py-1 font-mono text-[11px]", fit === "recommended" ? "bg-accent/15 text-accent" : "border border-edge text-secondary"]}>{fitLabel(fit)}</span>
              </div>
              <p class="mt-3 text-sm leading-6 text-secondary">{option.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {page.kind === "hardware" && hardware && (
      <section class="mt-14">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">What fits</p>
        <h2 class="mt-2 text-3xl font-semibold">Models ranked for {hardware.name}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {hardwareModels.map(({ model: item, fit }) => (
            <a href={`/advisor/model/${item.slug}`} class="rounded-lg border border-edge bg-surface-raised p-5 transition-colors hover:border-accent">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-[11px] uppercase text-muted">{categoryLabels[item.category]}</p>
                  <h3 class="mt-2 text-lg font-semibold">{item.name}</h3>
                </div>
                <span class:list={["rounded-full px-2.5 py-1 font-mono text-[11px]", fit === "recommended" ? "bg-accent/15 text-accent" : fit === "minimum" ? "border border-edge text-secondary" : "border border-edge/60 text-muted"]}>{fitLabel(fit)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {page.kind === "memory" && (
      <section class="mt-14">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">RAM-based shortlist</p>
        <h2 class="mt-2 text-3xl font-semibold">Models whose minimum system RAM is {page.ramGb} GB or less</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {memoryModels.map((item) => (
            <a href={`/advisor/model/${item.slug}`} class="rounded-lg border border-edge bg-surface-raised p-5 transition-colors hover:border-accent">
              <p class="font-mono text-[11px] uppercase text-muted">{categoryLabels[item.category]}</p>
              <h3 class="mt-2 text-lg font-semibold">{item.name}</h3>
              <p class="mt-2 text-sm text-secondary">Minimum {item.minRamGb} GB RAM · Recommended {item.recommendedRamGb} GB RAM · {item.minVramGb} GB minimum model memory</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-14 grid gap-5 md:grid-cols-2">
      <article class="rounded-lg border border-edge bg-surface-raised p-6">
        <h2 class="text-2xl font-semibold">Practical setup advice</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-secondary">
          <li class="flex gap-3"><span class="text-accent">•</span><span>Choose the exact quantization, resolution, context length, or workflow before buying hardware.</span></li>
          <li class="flex gap-3"><span class="text-accent">•</span><span>Leave memory headroom for the operating system, runtime, KV cache, VAE, text encoders, and workflow nodes.</span></li>
          <li class="flex gap-3"><span class="text-accent">•</span><span>Rent cloud hardware when a demanding model is only needed occasionally.</span></li>
        </ul>
      </article>
      <article class="rounded-lg border border-accent/60 bg-surface-raised p-6">
        <p class="font-mono text-xs uppercase tracking-wider text-accent">Next step</p>
        <h2 class="mt-3 text-2xl font-semibold">Compare the full model and hardware catalog</h2>
        <p class="mt-3 text-sm leading-6 text-secondary">Use the advisor to reverse-search by model, GPU, Mac, memory size, or workload type.</p>
        <a href="/advisor" class="mt-5 inline-flex rounded-md bg-accent px-4 py-2.5 font-mono text-sm font-semibold text-surface">Open hardware advisor</a>
      </article>
    </section>

    <section class="mt-14">
      <h2 class="text-3xl font-semibold">Frequently asked questions</h2>
      <div class="mt-6 space-y-3">
        {faq.map((item) => (
          <details class="rounded-lg border border-edge bg-surface-raised p-5">
            <summary class="cursor-pointer font-semibold text-primary">{item.question}</summary>
            <p class="mt-3 text-sm leading-6 text-secondary">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
