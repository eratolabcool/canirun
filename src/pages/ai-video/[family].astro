---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import Footer from "@/components/Footer.astro";
import {
  calculatorGpus,
  getVideoFamily,
  modelsForFamily,
  videoFamilies,
  type VideoFamily,
} from "@/data/video-models";
import { siteConfig } from "@/config/site";

export function getStaticPaths() {
  return videoFamilies.map((family) => ({ params: { family: family.slug }, props: { family } }));
}

interface Props { family: VideoFamily }
const { family } = Astro.props;
const models = modelsForFamily(family.slug);
const title = `${family.title} — ${siteConfig.shortName}`;
const description = family.description;

function gpuVerdict(vram: number, minimum: number, recommended: number) {
  if (vram >= recommended) return { label: "Comfortable", className: "result-good" };
  if (vram >= minimum) return { label: "Minimum", className: "result-warn" };
  return { label: "Not recommended", className: "result-bad" };
}
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: family.title,
      description,
      mainEntityOfPage: Astro.url.href,
      about: models.map((model) => ({ "@type": "SoftwareApplication", name: model.name, applicationCategory: "AI video generation" })),
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: family.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    })}></script>
  </Fragment>

  <NavHeader />

  <main class="pb-24">
    <section class="relative overflow-hidden border-b border-edge/70">
      <div class="hero-orb hero-orb-one"></div>
      <div class="hero-orb hero-orb-two"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
        <nav class="text-sm text-secondary" aria-label="Breadcrumb">
          <a href="/ai-video" class="hover:text-accent">Can I Run AI Video</a>
          <span class="mx-2 text-muted">/</span>
          <span>{family.name}</span>
        </nav>
        <div class="mt-8 max-w-4xl">
          <p class="eyebrow">{family.provider}</p>
          <h1 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-primary sm:text-7xl">{family.title}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-secondary sm:text-xl">{family.overview}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/ai-video" class="primary-button">Check my GPU</a>
            <a href="#models" class="secondary-button">Compare model versions</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="grid gap-5 lg:grid-cols-2">
        <article class="glass-panel p-6 sm:p-8">
          <p class="eyebrow">Why creators choose it</p>
          <h2 class="mt-3 text-2xl font-semibold">Strengths</h2>
          <ul class="mt-5 space-y-4 text-sm leading-6 text-secondary">
            {family.strengths.map((item) => <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent"></span><span>{item}</span></li>)}
          </ul>
        </article>
        <article class="glass-panel p-6 sm:p-8">
          <p class="eyebrow">Before buying hardware</p>
          <h2 class="mt-3 text-2xl font-semibold">Important limitations</h2>
          <ul class="mt-5 space-y-4 text-sm leading-6 text-secondary">
            {family.watchouts.map((item) => <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-warning"></span><span>{item}</span></li>)}
          </ul>
        </article>
      </div>
    </section>

    <section id="models" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-10 sm:px-6">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Version comparison</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Which {family.name} model can your GPU run?</h2>
        </div>
        <p class="max-w-2xl text-sm leading-6 text-secondary">The minimum tier means the model can load under the listed assumptions. The recommended tier leaves room for the operating system, VAE, text encoders, and workflow overhead.</p>
      </div>

      <div class="mt-8 grid gap-5">
        {models.map((model) => (
          <article class="glass-panel overflow-hidden">
            <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.2fr_0.8fr]">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="soft-pill">{model.tasks.map((task) => task.toUpperCase()).join(" · ")}</span>
                  <span class="text-xs text-muted">{model.preferredRuntime}</span>
                </div>
                <h3 class="mt-5 text-3xl font-semibold tracking-tight">{model.name}</h3>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-secondary">{model.summary}</p>
                <p class="mt-4 rounded-2xl border border-info/20 bg-info/5 p-4 text-sm leading-6 text-secondary">
                  <strong class="text-primary">Evidence:</strong> {model.evidence}
                </p>
              </div>
              <dl class="grid grid-cols-2 gap-3">
                <div class="metric-card"><dt>Minimum VRAM</dt><dd>{model.minimumVramGb} GB</dd></div>
                <div class="metric-card metric-card-accent"><dt>Recommended VRAM</dt><dd>{model.recommendedVramGb} GB</dd></div>
                <div class="metric-card"><dt>Recommended RAM</dt><dd>{model.recommendedRamGb} GB</dd></div>
                <div class="metric-card"><dt>Storage budget</dt><dd>{model.storageGb} GB</dd></div>
              </dl>
            </div>

            <div class="border-t border-edge/70 p-6 sm:p-8">
              <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
                <div>
                  <p class="eyebrow">Recommended setup</p>
                  <ul class="mt-4 space-y-3 text-sm leading-6 text-secondary">
                    {model.optimizationFlags.map((item) => <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent"></span><span>{item}</span></li>)}
                  </ul>
                  <a href={model.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-strong">Open {model.sourceLabel} ↗</a>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-edge">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead class="bg-surface-card text-xs uppercase tracking-[0.1em] text-muted">
                      <tr><th class="px-4 py-3">GPU</th><th class="px-4 py-3">VRAM</th><th class="px-4 py-3">Verdict</th></tr>
                    </thead>
                    <tbody>
                      {calculatorGpus.filter((gpu) => gpu.kind !== "apple" || model.family === "wan").map((gpu) => {
                        const verdict = gpuVerdict(gpu.vramGb, model.minimumVramGb, model.recommendedVramGb);
                        return (
                          <tr class="border-t border-edge/70">
                            <td class="px-4 py-3 font-medium text-primary">{gpu.name}</td>
                            <td class="px-4 py-3 text-secondary">{gpu.vramGb} GB</td>
                            <td class="px-4 py-3"><span class:list={["result-badge", verdict.className]}>{verdict.label}</span></td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="glass-panel p-6 sm:p-8">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Buying decision</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight">Local GPU or cloud GPU?</h2>
          </div>
          <a href="/advisor" class="secondary-button">Compare all hardware</a>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <article class="feature-card"><span class="eyebrow">Occasional use</span><h3 class="mt-3 text-xl font-semibold">Rent first</h3><p class="mt-3 text-sm leading-6 text-secondary">For a few heavy jobs per month, cloud GPU time is usually cheaper than buying a workstation around one model.</p></article>
          <article class="feature-card"><span class="eyebrow">Daily creation</span><h3 class="mt-3 text-xl font-semibold">Buy for VRAM</h3><p class="mt-3 text-sm leading-6 text-secondary">Prioritize usable VRAM and system RAM before gaming performance. Video models fail on capacity before they fail on raw compute.</p></article>
          <article class="feature-card"><span class="eyebrow">Production batches</span><h3 class="mt-3 text-xl font-semibold">Use a hybrid workflow</h3><p class="mt-3 text-sm leading-6 text-secondary">Iterate locally at lower resolution, then move selected jobs to a 48–80 GB cloud accelerator for final output.</p></article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <p class="eyebrow text-center">Frequently asked questions</p>
      <h2 class="mt-3 text-center text-3xl font-semibold tracking-tight">{family.name} hardware FAQ</h2>
      <div class="mt-8 space-y-4">
        {family.faq.map((item) => (
          <details class="faq-card group">
            <summary class="cursor-pointer list-none text-lg font-semibold text-primary">{item.question}</summary>
            <p class="mt-3 text-sm leading-6 text-secondary">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <div class="section-heading">
        <div><p class="eyebrow">Continue researching</p><h2 class="mt-3 text-2xl font-semibold">Other AI video families</h2></div>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {videoFamilies.filter((item) => item.slug !== family.slug).map((item) => (
          <a href={`/ai-video/${item.slug}`} class="feature-card group"><span class="eyebrow">{item.provider}</span><h3 class="mt-3 text-xl font-semibold group-hover:text-accent">{item.name}</h3><p class="mt-2 text-sm leading-6 text-secondary">{item.description}</p></a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
