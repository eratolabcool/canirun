---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import Footer from "@/components/Footer.astro";
import VideoCalculator from "@/components/VideoCalculator.astro";
import { videoFamilies } from "@/data/video-models";
import { siteConfig } from "@/config/site";

const title = `Can I Run AI Video? GPU and VRAM Calculator — ${siteConfig.shortName}`;
const description = "Can I Run AI Video on my GPU? Estimate VRAM, generation time, maximum resolution, frame count, batch size, quantization, CPU offload, and cloud GPU options for Wan, HunyuanVideo, and LTX Video.";
const faq = [
  {
    question: "Can I run AI video on a 12GB GPU?",
    answer: "Yes, but model choice matters. Lightweight Wan and older LTX Video workflows can fit, while Wan 14B, original HunyuanVideo, and full LTX 2.3 need much more memory or aggressive offload.",
  },
  {
    question: "What affects AI video VRAM use?",
    answer: "Model weights, precision, resolution, frame count, task type, VAE, text encoders, ControlNet or LoRA nodes, batch size, and whether components are offloaded to system RAM all affect peak VRAM.",
  },
  {
    question: "Are generation time estimates exact?",
    answer: "No. They are planning ranges. Runtime version, drivers, attention implementation, step count, thermal limits, and workflow nodes can change real generation time substantially.",
  },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: "Can I Run AI Video",
      url: new URL("/ai-video", Astro.site).href,
      description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Web Browser",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    })}></script>
  </Fragment>

  <NavHeader />

  <main class="pb-24">
    <section class="relative overflow-hidden border-b border-edge/70">
      <div class="hero-orb hero-orb-one"></div>
      <div class="hero-orb hero-orb-two"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
        <div class="max-w-4xl">
          <a href="/" class="eyebrow">Local AI hardware lab</a>
          <h1 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-primary sm:text-7xl">
            Can I Run AI Video?
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-secondary sm:text-xl">
            Calculate whether your GPU can run Wan, HunyuanVideo, or LTX. Get a practical VRAM range, generation-time estimate, safe resolution, frame limit, batch-size impact, quantization, offload plan, and cloud fallback.
          </p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm text-secondary">
            <span class="soft-pill">Wan 2.1 / 2.2</span>
            <span class="soft-pill">HunyuanVideo / 1.5</span>
            <span class="soft-pill">LTX Video / LTX 2.3</span>
            <span class="soft-pill">ComfyUI planning</span>
          </div>
          <a href="#calculator" class="primary-button mt-8">Calculate my setup</a>
        </div>
      </div>
    </section>

    <VideoCalculator />

    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Model guides</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Start with the model family</h2>
        </div>
        <p class="max-w-2xl text-sm leading-6 text-secondary">Each guide separates official hardware statements from planning estimates and explains which model version actually fits your GPU.</p>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {videoFamilies.map((family) => (
          <a href={`/ai-video/${family.slug}`} class="feature-card group">
            <span class="eyebrow">{family.provider}</span>
            <h3 class="mt-4 text-2xl font-semibold group-hover:text-accent">{family.name}</h3>
            <p class="mt-3 text-sm leading-6 text-secondary">{family.overview}</p>
            <span class="mt-6 inline-flex text-sm font-semibold text-accent">Open {family.name} guide →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="glass-panel p-6 sm:p-8">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Methodology</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight">What the calculator can and cannot know</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-secondary">The calculator is designed for purchase and workflow planning, not synthetic benchmark precision.</p>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <article class="feature-card">
            <span class="eyebrow">High confidence</span>
            <h3 class="mt-3 text-xl font-semibold">Model and memory facts</h3>
            <p class="mt-3 text-sm leading-6 text-secondary">Official minimums, model files, supported tasks, runtime restrictions, and documented offload behavior.</p>
          </article>
          <article class="feature-card">
            <span class="eyebrow">Estimated</span>
            <h3 class="mt-3 text-xl font-semibold">Peak VRAM and limits</h3>
            <p class="mt-3 text-sm leading-6 text-secondary">Resolution, frames, batch size, task type, precision, and offload are combined into a conservative planning range.</p>
          </article>
          <article class="feature-card">
            <span class="eyebrow">Variable</span>
            <h3 class="mt-3 text-xl font-semibold">Generation time</h3>
            <p class="mt-3 text-sm leading-6 text-secondary">Speed is shown as a range because drivers, kernels, custom nodes, steps, and thermals can materially change the result.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <p class="eyebrow text-center">Frequently asked questions</p>
      <h2 class="mt-3 text-center text-3xl font-semibold tracking-tight">AI video hardware questions</h2>
      <div class="mt-8 space-y-4">
        {faq.map((item) => (
          <details class="faq-card group">
            <summary class="cursor-pointer list-none text-lg font-semibold text-primary">{item.question}</summary>
            <p class="mt-3 text-sm leading-6 text-secondary">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
