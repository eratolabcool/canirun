---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import Footer from "@/components/Footer.astro";
import ModelListContent from "@/components/ModelListContent.astro";
import HardwareDecisionReport from "@/components/HardwareDecisionReport.astro";
import { siteConfig } from "@/config/site";

const title = `Can I Run AI Locally? Check Your PC, GPU and Mac — ${siteConfig.shortName}`;
const description = "Can I Run AI locally on my PC, GPU, or Mac? Detect your hardware, discover compatible local AI models, estimate speed and memory, and compare practical GPU upgrades.";
---

<Layout
  title={title}
  description={description}
  keywords={[
    "Can I Run AI Locally",
    "Can My PC Run AI",
    "Can My GPU Run AI",
    "Can I Run This Model",
    "Can I Run AI Video",
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: siteConfig.name,
      url: siteConfig.url,
      description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Web Browser",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    })}></script>
  </Fragment>

  <NavHeader />
  <HardwareDecisionReport />

  <ModelListContent>
    <header slot="header" class="relative mb-14 overflow-hidden rounded-[2rem] border border-edge/70 bg-surface-raised/80 px-5 py-10 text-center shadow-[0_30px_90px_rgba(3,7,24,0.22)] sm:px-10 sm:py-16">
      <div class="hero-orb hero-orb-one"></div>
      <div class="hero-orb hero-orb-two"></div>
      <div class="relative mx-auto max-w-4xl">
        <p class="eyebrow">Can I Run AI hardware checker</p>
        <h1 class="mt-5 text-5xl font-semibold tracking-[-0.05em] text-primary sm:text-7xl">
          Can I Run AI Locally?
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-secondary sm:text-xl">
          Check whether your PC, GPU, or Mac can run local AI. Compare model compatibility, VRAM, RAM, estimated speed, workload limits, and the most sensible upgrade before downloading a model or buying hardware.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="#hw-panel" class="primary-button">Can My PC Run AI?</a>
          <a href="/advisor" class="secondary-button">Can I Run This Model?</a>
        </div>

        <div class="mt-10 grid gap-4 text-left md:grid-cols-3">
          <a href="/ai-video" class="feature-card group border-accent/40 bg-accent/5">
            <span class="eyebrow">AI video calculator</span>
            <h2 class="mt-4 text-2xl font-semibold group-hover:text-accent">Can I Run AI Video?</h2>
            <p class="mt-3 text-sm leading-6 text-secondary">Estimate VRAM, generation time, resolution, frames, quantization, CPU offload, and cloud GPU options for Wan, HunyuanVideo, and LTX.</p>
            <span class="mt-5 inline-flex text-sm font-semibold text-accent">Check whether AI video can run →</span>
          </a>

          <a href="#hw-panel" class="feature-card group">
            <span class="eyebrow">PC and GPU compatibility</span>
            <h2 class="mt-4 text-2xl font-semibold group-hover:text-accent">Can My PC Run AI?</h2>
            <p class="mt-3 text-sm leading-6 text-secondary">Use browser detection and editable hardware profiles to rank compatible local AI models for your current computer.</p>
            <span class="mt-5 inline-flex text-sm font-semibold text-accent">Check my PC compatibility ↓</span>
          </a>

          <a href="/advisor" class="feature-card group">
            <span class="eyebrow">Model system requirements</span>
            <h2 class="mt-4 text-2xl font-semibold group-hover:text-accent">Can I Run This Model?</h2>
            <p class="mt-3 text-sm leading-6 text-secondary">Compare minimum, comfortable, professional, Mac, and cloud configurations before spending money.</p>
            <span class="mt-5 inline-flex text-sm font-semibold text-accent">Check model requirements →</span>
          </a>
        </div>
      </div>
    </header>
  </ModelListContent>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="can-i-run-questions">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Can I Run keyword hub</p>
        <h2 id="can-i-run-questions" class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Can I Run questions this site answers</h2>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-secondary">Every tool starts with a real compatibility question, then connects it to model requirements, GPU memory, system RAM, storage, and practical performance.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <a href="/" class="feature-card group">
        <span class="eyebrow">Local AI</span>
        <h3 class="mt-3 text-lg font-semibold group-hover:text-accent">Can I Run AI Locally?</h3>
      </a>
      <a href="/ai-video" class="feature-card group">
        <span class="eyebrow">AI video</span>
        <h3 class="mt-3 text-lg font-semibold group-hover:text-accent">Can I Run AI Video?</h3>
      </a>
      <a href="/advisor" class="feature-card group">
        <span class="eyebrow">AI model</span>
        <h3 class="mt-3 text-lg font-semibold group-hover:text-accent">Can I Run This Model?</h3>
      </a>
      <a href="/compare" class="feature-card group">
        <span class="eyebrow">GPU compatibility</span>
        <h3 class="mt-3 text-lg font-semibold group-hover:text-accent">Can My GPU Run AI?</h3>
      </a>
      <a href="#hw-panel" class="feature-card group">
        <span class="eyebrow">PC compatibility</span>
        <h3 class="mt-3 text-lg font-semibold group-hover:text-accent">Can My PC Run AI?</h3>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
