---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import ModelListContent from "@/components/ModelListContent.astro";
import HardwareDecisionReport from "@/components/HardwareDecisionReport.astro";
import { siteConfig } from "@/config/site";
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: siteConfig.name,
      url: Astro.site?.href,
      description: siteConfig.description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Web Browser",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    })}></script>
  </Fragment>

  <NavHeader />
  <HardwareDecisionReport />
  <ModelListContent>
    <header slot="header" class="mb-10 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent">Local AI Hardware Advisor</p>
      <h1 class="mt-4 font-pixel text-3xl tracking-tight text-accent sm:text-5xl">
        {siteConfig.question}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-secondary sm:text-lg">
        Detect your current hardware to find compatible models, or start with a model to discover the cheapest practical GPU, PC, Mac, or cloud setup.
      </p>

      <div class="mx-auto mt-8 grid max-w-3xl gap-4 text-left sm:grid-cols-2">
        <a href="#hw-panel" class="group rounded-lg border border-accent/60 bg-surface-raised p-5 transition-all hover:-translate-y-0.5 hover:border-accent">
          <p class="font-mono text-xs uppercase tracking-wider text-accent">My hardware → models</p>
          <h2 class="mt-3 text-xl font-semibold text-primary">What can my computer run?</h2>
          <p class="mt-2 text-sm leading-6 text-secondary">Use browser detection and the existing compatibility engine to rank local LLMs for this device.</p>
          <span class="mt-4 inline-flex font-mono text-sm text-accent">Detect below ↓</span>
        </a>

        <a href="/advisor" class="group rounded-lg border border-edge bg-surface-raised p-5 transition-all hover:-translate-y-0.5 hover:border-accent">
          <p class="font-mono text-xs uppercase tracking-wider text-accent">Model → hardware</p>
          <h2 class="mt-3 text-xl font-semibold text-primary">What computer does a model need?</h2>
          <p class="mt-2 text-sm leading-6 text-secondary">Compare LLM, image, video, speech, music, and ComfyUI requirements before buying hardware.</p>
          <span class="mt-4 inline-flex font-mono text-sm text-accent">Open hardware advisor →</span>
        </a>
      </div>
    </header>
  </ModelListContent>
</Layout>
